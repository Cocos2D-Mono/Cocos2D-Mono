<Project>
  <PropertyGroup>
    <!-- Single source of truth for the package version (and assembly version only for projects
         that generate assembly info). Bump here for a release; all packages inherit it. -->
    <Version>2.8.0</Version>

    <!-- Centralized MonoGame version for all projects -->
    <MonoGameVersion>3.8.5</MonoGameVersion>

    <!-- Several legacy csprojs relocate BaseIntermediateOutputPath per configuration
         (e.g. obj\DesktopGL\Release) from the csproj body - too late for the SDK's
         default compile-item excludes, so a build of one configuration would glob the
         generated AssemblyInfo/TargetFramework attribute files of another and fail with
         CS0579 duplicate-attribute errors. Excluding obj/bin explicitly covers every
         custom layout and makes configuration switches safe in one working tree. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>

    <!-- The WindowsDX TFM (net10.0-windows7.0) cannot even be restored on macOS or Linux
         without this: NETSDK1100 stops the whole multi-target restore, and a consumer's
         project reference (a game's Catalyst head, say) cannot narrow the TFM list
         because NuGet restore ignores reference metadata. Enabling Windows targeting off
         Windows restores and builds the WinForms-based TFM against reference assemblies;
         the one-time cost is the WindowsDesktop reference pack download. CI still narrows
         each cell to its own TFM and is unaffected. -->
    <EnableWindowsTargeting Condition="'$([MSBuild]::IsOSPlatform(`Windows`))' != 'true'">true</EnableWindowsTargeting>
  </PropertyGroup>

  <!--
    ==================== TFM version dials ====================

    Bumping .NET or a per-platform TFM is a single-file edit here. Consumed by
    the consolidated csprojs under src/ (Cocos2DMono, Box2D) via
    $(Cocos2DTargetFrameworks) and their per-TFM Condition checks.

    Also consumed by the consolidated test projects under Tests/:
    Cocos2DMono.UnitTests targets $(Cocos2DBaseTfm) and
    Cocos2DMono.IntegrationTests multi-targets $(Cocos2DTargetFrameworks),
    so a TFM bump here carries the whole repo - src/, tests, and CI (the
    workflows narrow builds with -p:Cocos2DTargetFrameworks=<tfm>).

    2.6.0: these dials moved the build from net9 + MonoGame 3.8.4.1 to
    net10 + MonoGame 3.8.5 with no csproj edits - the payoff of the
    Stage C consolidation.
  -->
  <!-- The Condition guards keep each dial overridable from the environment or the
       command line (-p:). Tools without an msbuild-property passthrough (e.g.
       `dotnet format`, which otherwise evaluates every TFM and can emit unmerged-
       change conflict markers when per-TFM edits diverge) can narrow the build by
       exporting e.g. Cocos2DTargetFrameworks=net10.0. -->
  <PropertyGroup>
    <Cocos2DBaseTfm Condition="'$(Cocos2DBaseTfm)' == ''">net10.0</Cocos2DBaseTfm>
    <Cocos2DWindowsTfm Condition="'$(Cocos2DWindowsTfm)' == ''">net10.0-windows7.0</Cocos2DWindowsTfm>
    <Cocos2DAndroidTfm Condition="'$(Cocos2DAndroidTfm)' == ''">net10.0-android36.0</Cocos2DAndroidTfm>
    <Cocos2DIosTfm Condition="'$(Cocos2DIosTfm)' == ''">net10.0-ios26.0</Cocos2DIosTfm>
    <Cocos2DMacCatalystTfm Condition="'$(Cocos2DMacCatalystTfm)' == ''">net10.0-maccatalyst26.0</Cocos2DMacCatalystTfm>
    <Cocos2DTvosTfm Condition="'$(Cocos2DTvosTfm)' == ''">net10.0-tvos26.0</Cocos2DTvosTfm>
  </PropertyGroup>

  <!--
    ============ Mac Catalyst (C2D-238) and tvOS (C2D-239): fork-built MonoGame ============

    MonoGame publishes no maccatalyst or tvos package (still true at 3.8.5), so those
    TFMs build against the MonoGame.Framework assemblies produced by our fork:
      https://github.com/Cocos2D-Mono/MonoGame   (branch cocos2d-mono)
      dotnet build MonoGame.Framework/MonoGame.Framework.MacCatalyst.csproj -c <Configuration>
      dotnet build MonoGame.Framework/MonoGame.Framework.tvOS.csproj -c <Configuration>
    which write Artifacts/MonoGame.Framework/{MacCatalyst,tvOS}/<Configuration>/MonoGame.Framework.dll.
    $(MonoGameForkArtifactsRoot) points at that Artifacts/MonoGame.Framework folder; the
    default is a checkout of the fork beside this repo, and an override may be given with
    or without a trailing separator. Each platform's folder can also be overridden on its
    own ($(MonoGameMacCatalystArtifactsRoot), $(MonoGameTvosArtifactsRoot)).

    The maccatalyst and tvos workloads exist only on macOS, and each reference only
    resolves when the fork has been built for that platform, so each TFM joins the
    default list only when both hold. Every other host, and every checkout without the
    fork, builds the four shipped TFMs unchanged. Force either one with
    -p:Cocos2DIncludeMacCatalyst=true|false and -p:Cocos2DIncludeTvos=true|false.

    Packing never auto-includes them (C2D-259). A published package only carries a TFM
    whose MonoGame dependency can be restored from nuget.org (C2D-246), and these two
    reference the fork by HintPath: NuGet records no dependency for that and the fork's
    DLL is not packed, so a Catalyst or tvOS TFM in a .nupkg would fail for every
    consumer. `dotnet pack` sets _IsPacking=true as a global property, so the probes
    below skip that case and a pack on a Mac with the fork built still produces the four
    shipped TFMs. An explicit -p:Cocos2DInclude...=true still forces one in, for anyone
    deliberately experimenting. (Invoking the Pack target through msbuild directly does
    not set _IsPacking; releases go through `dotnet pack` in pack.yml.)
  -->
  <PropertyGroup>
    <MonoGameForkArtifactsRoot Condition="'$(MonoGameForkArtifactsRoot)' == ''">$(MSBuildThisFileDirectory)..\MonoGame\Artifacts\MonoGame.Framework</MonoGameForkArtifactsRoot>
    <MonoGameMacCatalystArtifactsRoot Condition="'$(MonoGameMacCatalystArtifactsRoot)' == ''">$([System.IO.Path]::Combine('$(MonoGameForkArtifactsRoot)', 'MacCatalyst'))</MonoGameMacCatalystArtifactsRoot>
    <MonoGameTvosArtifactsRoot Condition="'$(MonoGameTvosArtifactsRoot)' == ''">$([System.IO.Path]::Combine('$(MonoGameForkArtifactsRoot)', 'tvOS'))</MonoGameTvosArtifactsRoot>

    <!-- Resolve which of the fork's configuration folders this build references, per
         platform. $(Configuration) is only set this early when it was passed in (-c, or a
         referencing project); otherwise the SDK defaults it to Debug later, so Debug is
         assumed in that case. A configuration the fork has not been built for (a
         consumer's AppStore configuration, say) falls back to Release, then Debug, so the
         reference binds to an artifact that exists. The csprojs use the resolved value
         for their HintPaths, so the opt-in probe and the reference always agree. -->
    <MonoGameMacCatalystAssemblyConfiguration Condition="'$(MonoGameMacCatalystAssemblyConfiguration)' == ''">$(Configuration)</MonoGameMacCatalystAssemblyConfiguration>
    <MonoGameMacCatalystAssemblyConfiguration Condition="'$(MonoGameMacCatalystAssemblyConfiguration)' == ''">Debug</MonoGameMacCatalystAssemblyConfiguration>
    <MonoGameMacCatalystAssemblyConfiguration Condition="!Exists('$([System.IO.Path]::Combine(`$(MonoGameMacCatalystArtifactsRoot)`, `$(MonoGameMacCatalystAssemblyConfiguration)`, `MonoGame.Framework.dll`))') and Exists('$([System.IO.Path]::Combine(`$(MonoGameMacCatalystArtifactsRoot)`, `Release`, `MonoGame.Framework.dll`))')">Release</MonoGameMacCatalystAssemblyConfiguration>
    <MonoGameMacCatalystAssemblyConfiguration Condition="!Exists('$([System.IO.Path]::Combine(`$(MonoGameMacCatalystArtifactsRoot)`, `$(MonoGameMacCatalystAssemblyConfiguration)`, `MonoGame.Framework.dll`))') and Exists('$([System.IO.Path]::Combine(`$(MonoGameMacCatalystArtifactsRoot)`, `Debug`, `MonoGame.Framework.dll`))')">Debug</MonoGameMacCatalystAssemblyConfiguration>
    <MonoGameMacCatalystAssembly>$([System.IO.Path]::Combine('$(MonoGameMacCatalystArtifactsRoot)', '$(MonoGameMacCatalystAssemblyConfiguration)', 'MonoGame.Framework.dll'))</MonoGameMacCatalystAssembly>
    <Cocos2DIncludeMacCatalyst Condition="'$(Cocos2DIncludeMacCatalyst)' == '' and '$(_IsPacking)' != 'true' and '$([MSBuild]::IsOSPlatform(`OSX`))' == 'true' and Exists('$(MonoGameMacCatalystAssembly)')">true</Cocos2DIncludeMacCatalyst>

    <MonoGameTvosAssemblyConfiguration Condition="'$(MonoGameTvosAssemblyConfiguration)' == ''">$(Configuration)</MonoGameTvosAssemblyConfiguration>
    <MonoGameTvosAssemblyConfiguration Condition="'$(MonoGameTvosAssemblyConfiguration)' == ''">Debug</MonoGameTvosAssemblyConfiguration>
    <MonoGameTvosAssemblyConfiguration Condition="!Exists('$([System.IO.Path]::Combine(`$(MonoGameTvosArtifactsRoot)`, `$(MonoGameTvosAssemblyConfiguration)`, `MonoGame.Framework.dll`))') and Exists('$([System.IO.Path]::Combine(`$(MonoGameTvosArtifactsRoot)`, `Release`, `MonoGame.Framework.dll`))')">Release</MonoGameTvosAssemblyConfiguration>
    <MonoGameTvosAssemblyConfiguration Condition="!Exists('$([System.IO.Path]::Combine(`$(MonoGameTvosArtifactsRoot)`, `$(MonoGameTvosAssemblyConfiguration)`, `MonoGame.Framework.dll`))') and Exists('$([System.IO.Path]::Combine(`$(MonoGameTvosArtifactsRoot)`, `Debug`, `MonoGame.Framework.dll`))')">Debug</MonoGameTvosAssemblyConfiguration>
    <MonoGameTvosAssembly>$([System.IO.Path]::Combine('$(MonoGameTvosArtifactsRoot)', '$(MonoGameTvosAssemblyConfiguration)', 'MonoGame.Framework.dll'))</MonoGameTvosAssembly>
    <Cocos2DIncludeTvos Condition="'$(Cocos2DIncludeTvos)' == '' and '$(_IsPacking)' != 'true' and '$([MSBuild]::IsOSPlatform(`OSX`))' == 'true' and Exists('$(MonoGameTvosAssembly)')">true</Cocos2DIncludeTvos>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Cocos2DTargetFrameworks)' == ''">
    <Cocos2DTargetFrameworks>$(Cocos2DBaseTfm);$(Cocos2DWindowsTfm);$(Cocos2DAndroidTfm);$(Cocos2DIosTfm)</Cocos2DTargetFrameworks>
    <Cocos2DTargetFrameworks Condition="'$(Cocos2DIncludeMacCatalyst)' == 'true'">$(Cocos2DTargetFrameworks);$(Cocos2DMacCatalystTfm)</Cocos2DTargetFrameworks>
    <Cocos2DTargetFrameworks Condition="'$(Cocos2DIncludeTvos)' == 'true'">$(Cocos2DTargetFrameworks);$(Cocos2DTvosTfm)</Cocos2DTargetFrameworks>
  </PropertyGroup>

  <!--
    ==================== Warnings as errors in CI (C2D-198) ====================

    In CI ($(CI) is true: GitHub Actions sets it in every workflow, pack.yml included), a
    compiler, analyzer or NuGet warning fails the build, except for the codes listed below.
    Those still have warnings to clear. Each C2D-198 slice that clears a code deletes it
    here, so don't add codes. Local builds keep warnings as warnings; build with
    -p:CI=true to see what CI will do.

    NuGet's audit warnings (NU1901-NU1904) fail it too, for direct and transitive
    packages. Update the package, or review the advisory and add a NuGetAuditSuppress
    item for it.

    Warnings from other MSBuild tasks stay warnings: MSBuildTreatWarningsAsErrors is off.
    The engine build logs one from MonoGame's content task ("No Content References
    Found") that has no code, so MSBuildWarningsNotAsErrors couldn't exempt it.
  -->
  <PropertyGroup Condition="'$(CI)' == 'true'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Members that hide inherited ones -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CS0108;CS0114</WarningsNotAsErrors>
    <!-- == and != without Equals and GetHashCode -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CS0659;CS0660;CS0661</WarningsNotAsErrors>
    <!-- Android APIs obsoleted in later versions -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CA1422</WarningsNotAsErrors>
    <!-- Trim analysis, which waits for the 3.0 trim-safety work -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL2026;IL2057;IL2060;IL2111</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
