<?xml version="1.0" encoding="utf-8"?>
<!-- Cocos2D-Mono and its Box2D package come only from the packages pack.yml just built, in
     artifacts/ at the repository root, so no other copy can answer for them. Everything else
     comes from nuget.org. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="packed" value="../../artifacts" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="packed">
      <package pattern="Cocos2D-Mono" />
      <package pattern="Cocos2D-Mono.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
